    "graph": [
        {
            "id": "concept:be",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.be",
            "definition": "Fenestrae. Holten van millimetergrootte in sedimentaire gesteente die geheel of gedeeltelijk opgevuld kunnen zijn door sediment of cement, gevormd door uitdroging of insluiting van lucht.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "BE",
            "note": "Fenestrae. Holten van millimetergrootte in sedimentaire gesteente die geheel of gedeeltelijk opgevuld kunnen zijn door sediment of cement, gevormd door uitdroging of insluiting van lucht.",
            "prefLabel": "birdseyes",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:bk",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.bk",
            "definition": "Korrels die bestaan uit de overblijfselen van organismen, vaak microscopische kalkskeletjes.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "BK",
            "note": "Korrels die bestaan uit de overblijfselen van organismen, vaak microscopische kalkskeletjes.",
            "prefLabel": "bioklasten",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:bo",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.bo",
            "definition": "Kalksteen waarbij de korrels aaneengekit zijn door organismen.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "BO",
            "note": "Kalksteen waarbij de korrels aaneengekit zijn door organismen.",
            "prefLabel": "boundstone textuur",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:br",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.br",
            "definition": "Klastisch met grove hoekige fragmenten.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "BR",
            "note": "Klastisch met grove hoekige fragmenten.",
            "prefLabel": "breccieus",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:bt",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.bt",
            "definition": "Het omwoelen van sediment, hoofdzakelijk door gravende organismen.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "BT",
            "note": "Het omwoelen van sediment, hoofdzakelijk door gravende organismen.",
            "prefLabel": "bioturbatie",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:ca",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.ca",
            "definition": "Een poederig, nodulair tot sterk verhard materiaal dat nabij het oppervlak gevormd is in een ariede tot semi-ariede omgeving, door cementatie door calciet, aangevoerd door grondwater in het sediment en de bodem.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "CA",
            "note": "Een poederig, nodulair tot sterk verhard materiaal dat nabij het oppervlak gevormd is in een ariede tot semi-ariede omgeving, door cementatie door calciet, aangevoerd door grondwater in het sediment en de bodem.",
            "prefLabel": "calcrete / caliche",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:cb",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.cb",
            "definition": "Breuken ontstaan door compactie van het sediment bij begraving.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "CB",
            "note": "Breuken ontstaan door compactie van het sediment bij begraving.",
            "prefLabel": "compactiebreuken",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:co",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.co",
            "definition": "Nodule, vaak sferisch maar kan ook irregulair van vorm zijn. Vaak bestaande uit carbonaatmateriaal, pyriet, gips of silica.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "CO",
            "note": "Nodule, vaak sferisch maar kan ook irregulair van vorm zijn. Vaak bestaande uit carbonaatmateriaal, pyriet, gips of silica.",
            "prefLabel": "concretie",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:cu",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.cu",
            "definition": "Gelaagd sediment waarbij de korrelgrootte toeneemt naar boven toe.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "CU",
            "note": "Gelaagd sediment waarbij de korrelgrootte toeneemt naar boven toe.",
            "prefLabel": "CU-gegradeerde gelaagdheid",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:ep",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.ep",
            "definition": "Een secundair evaporiet mineraal dat de vorm van het oorspronkelijke mineraal of fossiel heeft behouden.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "EP",
            "note": "Een secundair evaporiet mineraal dat de vorm van het oorspronkelijke mineraal of fossiel heeft behouden.",
            "prefLabel": "evaporiet pseudomorfen",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:ev",
            "type": "skos:Concept",
            "dc.identifier": "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.ev",
            "definition": "Een vlak (of lijn in een 2D profiel) waarop erosie heeft plaatsgevonden. Het bovenliggende pakket is ingesneden in het onderliggende pakket. Dit vlak kan recht of onregelmatig ondulerend zijn. Vaak is er een basisgrind aanwezig aan de basis van het bovenliggende pakket.",
            "inScheme": "conceptscheme:sedimentairestructuurtype",
            "notation": "EV",
            "note": "Een vlak (of lijn in een 2D profiel) waarop erosie heeft plaatsgevonden. Het bovenliggende pakket is ingesneden in het onderliggende pakket. Dit vlak kan recht of onregelmatig ondulerend zijn. Vaak is er een basisgrind aanwezig aan de basis van het bovenliggende pakket.",
            "prefLabel": "erosievlak",
            "topConceptOf": "conceptscheme:sedimentairestructuurtype"
        },
        {
            "id": "concept:fb",
