concept:fs dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.fs";
    a skos:Concept;
    skos:definition "Een grofkorrelige kalksteen waarbij meer dan 10% van de klasten groter is dan 2 mm. De klasten worden door de matrix gedragen."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "FS";
    skos:note "Een grofkorrelige kalksteen waarbij meer dan 10% van de klasten groter is dan 2 mm. De klasten worden door de matrix gedragen."@nl;
