    a skos:Concept;
    skos:definition "Een verhard oppervlak, gevormd door synsedimentaire lithificatie van sediment op de zeebodem tijdens een periode van verminderde sedimentatiesnelheid."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "HG";
