    skos:definition "Sediment rijk aan fossielen."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "FO";
    skos:note "Sediment rijk aan fossielen."@nl;
    skos:prefLabel "fossielrijk"@nl;
