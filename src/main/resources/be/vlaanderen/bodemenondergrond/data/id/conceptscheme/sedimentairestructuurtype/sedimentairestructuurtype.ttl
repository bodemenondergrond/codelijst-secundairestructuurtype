concept:be dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.be";
    a skos:Concept;
    skos:definition "Fenestrae. Holten van millimetergrootte in sedimentaire gesteente die geheel of gedeeltelijk opgevuld kunnen zijn door sediment of cement, gevormd door uitdroging of insluiting van lucht."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "BE";
    skos:note "Fenestrae. Holten van millimetergrootte in sedimentaire gesteente die geheel of gedeeltelijk opgevuld kunnen zijn door sediment of cement, gevormd door uitdroging of insluiting van lucht."@nl;
    skos:prefLabel "birdseyes"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:bk dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.bk";
    a skos:Concept;
    skos:definition "Korrels die bestaan uit de overblijfselen van organismen, vaak microscopische kalkskeletjes."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "BK";
    skos:note "Korrels die bestaan uit de overblijfselen van organismen, vaak microscopische kalkskeletjes."@nl;
    skos:prefLabel "bioklasten"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:bo dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.bo";
    a skos:Concept;
    skos:definition "Kalksteen waarbij de korrels aaneengekit zijn door organismen."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "BO";
    skos:note "Kalksteen waarbij de korrels aaneengekit zijn door organismen."@nl;
    skos:prefLabel "boundstone textuur"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:br dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.br";
    a skos:Concept;
    skos:definition "Klastisch met grove hoekige fragmenten."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "BR";
    skos:note "Klastisch met grove hoekige fragmenten."@nl;
    skos:prefLabel "breccieus"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:bt dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.bt";
    a skos:Concept;
    skos:definition "Het omwoelen van sediment, hoofdzakelijk door gravende organismen."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "BT";
    skos:note "Het omwoelen van sediment, hoofdzakelijk door gravende organismen."@nl;
    skos:prefLabel "bioturbatie"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:ca dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.ca";
    a skos:Concept;
    skos:definition "Een poederig, nodulair tot sterk verhard materiaal dat nabij het oppervlak gevormd is in een ariede tot semi-ariede omgeving, door cementatie door calciet, aangevoerd door grondwater in het sediment en de bodem."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "CA";
    skos:note "Een poederig, nodulair tot sterk verhard materiaal dat nabij het oppervlak gevormd is in een ariede tot semi-ariede omgeving, door cementatie door calciet, aangevoerd door grondwater in het sediment en de bodem."@nl;
    skos:prefLabel "calcrete / caliche"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:cb dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.cb";
    a skos:Concept;
    skos:definition "Breuken ontstaan door compactie van het sediment bij begraving."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "CB";
    skos:note "Breuken ontstaan door compactie van het sediment bij begraving."@nl;
    skos:prefLabel "compactiebreuken"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:co dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.co";
    a skos:Concept;
    skos:definition "Nodule, vaak sferisch maar kan ook irregulair van vorm zijn. Vaak bestaande uit carbonaatmateriaal, pyriet, gips of silica."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "CO";
    skos:note "Nodule, vaak sferisch maar kan ook irregulair van vorm zijn. Vaak bestaande uit carbonaatmateriaal, pyriet, gips of silica."@nl;
    skos:prefLabel "concretie"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:cu dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.cu";
    a skos:Concept;
    skos:definition "Gelaagd sediment waarbij de korrelgrootte toeneemt naar boven toe."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "CU";
    skos:note "Gelaagd sediment waarbij de korrelgrootte toeneemt naar boven toe."@nl;
    skos:prefLabel "CU-gegradeerde gelaagdheid"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:ep dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.ep";
    a skos:Concept;
    skos:definition "Een secundair evaporiet mineraal dat de vorm van het oorspronkelijke mineraal of fossiel heeft behouden."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "EP";
    skos:note "Een secundair evaporiet mineraal dat de vorm van het oorspronkelijke mineraal of fossiel heeft behouden."@nl;
    skos:prefLabel "evaporiet pseudomorfen"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
concept:ev dc:identifier "be.vlaanderen.bodemenondergrond.data.id.concept.sedimentairestructuurtype.ev";
    a skos:Concept;
    skos:definition "Een vlak (of lijn in een 2D profiel) waarop erosie heeft plaatsgevonden. Het bovenliggende pakket is ingesneden in het onderliggende pakket. Dit vlak kan recht of onregelmatig ondulerend zijn. Vaak is er een basisgrind aanwezig aan de basis van het bovenliggende pakket."@nl;
    skos:inScheme conceptscheme:sedimentairestructuurtype;
    skos:notation "EV";
    skos:note "Een vlak (of lijn in een 2D profiel) waarop erosie heeft plaatsgevonden. Het bovenliggende pakket is ingesneden in het onderliggende pakket. Dit vlak kan recht of onregelmatig ondulerend zijn. Vaak is er een basisgrind aanwezig aan de basis van het bovenliggende pakket."@nl;
    skos:prefLabel "erosievlak"@nl;
    skos:topConceptOf conceptscheme:sedimentairestructuurtype.
